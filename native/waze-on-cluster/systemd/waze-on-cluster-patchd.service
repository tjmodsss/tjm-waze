[Unit]
Description=waze-on-cluster patchd: applies/reverts the reversible carplay and Android Auto patches on the iDrive app's request, and the bounded Waze diagnostic capture
RequiresMountsFor=/var/opt
# dlt.service: the capture's restore at a stop reaches the DLT daemon,
# which stops after this.
After=local-fs.target dlt.service

[Service]
# Root, like mgu-updater: the app (unprivileged, in tm_oap_app) asks over the
# socket; this daemon runs the vetted, reversible carplay_patch.js or
# aapd_patch.js with / briefly remounted read-write, then activates the
# change per PATCH.md "Activation" (SIGKILL+start only where recmgr allows
# it, otherwise at the next head-unit start). It applies no patch on its own.
# --dlt-capture: it also runs the DLT capture service (dlt_capture.js); a
# failure of that service restarts the service, not the daemon. While a
# waze-on-cluster-capture.service (a downgrade lays one) is installed or
# runs, that unit serves the capture and the daemon does not.
ExecStart=/usr/bin/node /var/opt/waze-on-cluster/current/patchd.js --dlt-capture
# However the daemon ended, a capture left open is closed and DLT put back
# as it was, unless a waze-on-cluster-capture.service is installed or runs:
# the capture is that unit's then, and its own ExecStopPost restores it.
ExecStopPost=-/bin/sh -c '[ -e /etc/systemd/system/waze-on-cluster-capture.service ] || systemctl -q is-active waze-on-cluster-capture.service || exec /usr/bin/node /var/opt/waze-on-cluster/current/dlt_capture.js restore'
Restart=always
RestartSec=5
StandardOutput=journal
# The head unit's slice for its standard services, where carplay and
# aapd run: not ahead of the HMI, and level with the services it
# patches and restarts, so its bounded steps get CPU time while the unit is busy.
Slice=standard.slice
# On stop, signal only the daemon (not its mount/patch/systemctl children), and
# give an in-progress patch time to finish so / is never left writable.
KillMode=mixed
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
